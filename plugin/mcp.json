{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "relay": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "clio-relay @ git+https://github.com/iowarp/clio-relay@882b09c7b574a299969f57931df76f0b05d59ce0",
        "clio-relay",
        "serve"
      ],
      "env": {
        "CLIO_RELAY_CONFIG_DIR": "${PLUGIN_DATA}/config",
        "CLIO_RELAY_STATE_DIR": "${PLUGIN_DATA}/state",
        "CLIO_RELAY_GRANT_FILE_GLOBUS": "${CLIO_ACCOUNT_GLOBUS_FILE}"
      }
    }
  }
}
