{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "relay": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "clio-relay @ git+https://github.com/iowarp/clio-relay@2c4e1dee63f8c5b0ed7c337d41927f4c3b6c5e3f",
        "clio-relay-next",
        "serve"
      ],
      "env": {
        "CLIO_RELAY_GRANT_FILE_GLOBUS": "${CLIO_ACCOUNT_GLOBUS_FILE}"
      }
    }
  }
}
